#!/bin/sh
set -eu

appdir=${APPDIR:-"$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"}
export PYTHONHOME="$appdir/usr"
export LD_LIBRARY_PATH="$appdir/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PORCHLIGHT_WEBDIR="$appdir/usr/share/porchlight/web"
export PORCHLIGHT_MODEL="$appdir/usr/share/porchlight/models/nanodet-plus-m-416.onnx"
python="$appdir/usr/bin/python3"
server="$appdir/usr/share/porchlight/server/porchlight_server.py"

if [ "${1:-}" = "--server-only" ]; then
    exec "$python" "$server"
fi

url="http://127.0.0.1:${PORCHLIGHT_PORT:-8321}/"
if "$python" -c 'import socket,sys; s=socket.socket(); s.settimeout(.2); sys.exit(s.connect_ex(("127.0.0.1", int(sys.argv[1]))))' "${PORCHLIGHT_PORT:-8321}"; then
    exec env -u PYTHONHOME -u LD_LIBRARY_PATH xdg-open "$url"
fi

"$python" "$server" &
pid=$!
trap 'kill "$pid" 2>/dev/null || true' EXIT INT TERM
i=0
while [ "$i" -lt 50 ]; do
    "$python" -c 'import socket,sys; s=socket.socket(); s.settimeout(.2); sys.exit(s.connect_ex(("127.0.0.1", int(sys.argv[1]))))' "${PORCHLIGHT_PORT:-8321}" && break
    kill -0 "$pid" 2>/dev/null || wait "$pid"
    i=$((i + 1))
    sleep .1
done
env -u PYTHONHOME -u LD_LIBRARY_PATH xdg-open "$url" >/dev/null 2>&1 || true
wait "$pid"
